{
  "name": "wyrihaximus/react-stream-json",
  "description": "Incremental JSON encoder writing to a react/stream",
  "license": "MIT",
  "authors": [
    {
      "name": "Cees-Jan Kiewiet",
      "email": "ceesjank@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "ext-json": "*",
    "evenement/evenement": "^3.0.2",
    "react/promise": "^2.10 || ^3.3.0",
    "react/stream": "^1.3.0",
    "reactivex/rxphp": "^2.0.11",
    "thecodingmachine/safe": "^2.5 || ^3.0.0"
  },
  "require-dev": {
    "react/promise-stream": "^1.5",
    "wyrihaximus/async-test-utilities": "^12.2.0",
    "wyrihaximus/makefiles": "^0.7.6",
    "wyrihaximus/ticking-promise": "^3"
  },
  "autoload": {
    "psr-4": {
      "WyriHaximus\\React\\Stream\\Json\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WyriHaximus\\React\\Tests\\Stream\\Json\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "composer/package-versions-deprecated": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true,
      "icanhazstring/composer-unused": true,
      "infection/extension-installer": true,
      "localheinz/composer-normalize": true,
      "ocramius/package-versions": true,
      "phpstan/extension-installer": true,
      "wyrihaximus/makefiles": true,
      "wyrihaximus/test-utilities": true
    },
    "platform": {
      "php": "8.4.13"
    },
    "sort-packages": true
  },
  "scripts": {
    "post-install-cmd": [
      "make on-install-or-update || true"
    ],
    "post-update-cmd": [
      "make on-install-or-update || true"
    ]
  }
}
